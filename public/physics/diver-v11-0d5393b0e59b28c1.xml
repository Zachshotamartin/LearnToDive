<!-- v11 native trainer model. v7 added paired hip adduction; v6 lumped ankle and midfoot pitch.
     v11 raises the leg, arm and adduction torque caps to athletic values (knee 260 Nm, hip 240 Nm,
     ankle 180 Nm, shoulder 120 Nm) and lowers servo damping so a bounded countermovement jump is
     physically possible; the old kv=18 servos braked any joint moving faster than the slewing target.
     Still no root actuator; every force is a bounded joint servo. -->
<mujoco model="learn_to_dive_articulated">
  <compiler angle="radian" autolimits="true" />
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton" iterations="30" tolerance="1e-9">
    <flag warmstart="disable" />
  </option>
  <size nconmax="160" njmax="600" />
  <default>
    <joint damping="1.8" armature="0.025" limited="true" />
    <geom friction="0.8 0.02 0.002" solref="0.008 1" solimp="0.95 0.99 0.001" condim="3" />
    <position ctrllimited="true" forcelimited="true" />
    <default class="arm">
      <joint damping="0.7" armature="0.01" />
      <geom type="capsule" size="0.05" />
    </default>
    <default class="leg">
      <geom type="capsule" size="0.075" />
    </default>
  </default>
  <worldbody>
    <body name="board" pos="-1.275 0 0">
      <joint name="board_spring" type="slide" axis="0 0 1" range="-0.25 0.04" stiffness="18000" damping="140" springref="0" />
      <geom name="board_surface" type="box" size="1.275 0.48 0.055" mass="24" />
    </body>
    <body name="pelvis" pos="-0.13 0 0.95">
      <freejoint name="root" />
      <geom name="hip_geom" type="ellipsoid" size="0.16 0.18 0.14" mass="8" />
      <site name="pelvis" pos="0 0 0" />
      <body name="torso" pos="0 0 0.08">
        <geom type="capsule" fromto="0 0 0 0 0 0.39" size="0.15" mass="26" name="athlete_geom_2" />
        <site name="chest" pos="0 0 0.36" />
        <site name="neck" pos="0 0 0.51" />
        <body name="head" pos="0 0 0.61">
          <geom type="sphere" size="0.094" mass="5" name="athlete_geom_3" />
          <site name="head" pos="0 0 0" />
        </body>
        <body name="upper_arm_L" pos="0 0.22 0.34" childclass="arm">
          <joint name="shoulder_pitch_L" type="hinge" axis="0 -1 0" range="-0.6 3.25" />
          <joint name="shoulder_roll_L" type="hinge" axis="1 0 0" range="-1.2 1.2" />
          <geom fromto="0 0 0 0 0 -0.30" mass="2.1" name="athlete_geom_4" />
          <site name="shoulderL" />
          <body name="forearm_L" pos="0 0 -0.30">
            <joint name="elbow_L" axis="0 -1 0" range="0 2.4" />
            <geom fromto="0 0 0 0 0 -0.28" size="0.042" mass="1.3" name="athlete_geom_5" />
            <site name="elbowL" />
            <body name="hand_L" pos="0 0 -0.28">
              <geom type="ellipsoid" size="0.038 0.055 0.09" pos="0 0 -0.055" mass="0.6" name="athlete_geom_6" />
              <site name="wristL" />
              <site name="handL" pos="0 0 -0.13" />
            </body>
          </body>
        </body>
        <body name="upper_arm_R" pos="0 -0.22 0.34" childclass="arm">
          <joint name="shoulder_pitch_R" type="hinge" axis="0 -1 0" range="-0.6 3.25" />
          <joint name="shoulder_roll_R" type="hinge" axis="1 0 0" range="-1.2 1.2" />
          <geom fromto="0 0 0 0 0 -0.30" mass="2.1" name="athlete_geom_7" />
          <site name="shoulderR" />
          <body name="forearm_R" pos="0 0 -0.30">
            <joint name="elbow_R" axis="0 -1 0" range="0 2.4" />
            <geom fromto="0 0 0 0 0 -0.28" size="0.042" mass="1.3" name="athlete_geom_8" />
            <site name="elbowR" />
            <body name="hand_R" pos="0 0 -0.28">
              <geom type="ellipsoid" size="0.038 0.055 0.09" pos="0 0 -0.055" mass="0.6" name="athlete_geom_9" />
              <site name="wristR" />
              <site name="handR" pos="0 0 -0.13" />
            </body>
          </body>
        </body>
      </body>
      <body name="thigh_L" pos="0 0.105 -0.055" childclass="leg">
        <joint name="hip_L" axis="0 -1 0" range="-0.5 2.3" />
<joint name="hip_adduction_L" axis="-1 0 0" range="-0.2 0.25" damping="2" />
        <geom fromto="0 0 0 0 0 -0.42" mass="7" name="athlete_geom_10" />
        <site name="hipL" />
        <body name="shin_L" pos="0 0 -0.42">
          <joint name="knee_L" axis="0 1 0" range="0 2.7" />
          <geom fromto="0 0 0 0 0 -0.42" size="0.06" mass="3.5" name="athlete_geom_11" />
          <site name="kneeL" />
          <body name="foot_L" pos="0 0 -0.42">
            <joint name="ankle_L" axis="0 1 0" range="-0.6 1.4" />
            <geom type="box" size="0.13 0.055 0.04" pos="0.055 0 -0.025" mass="1" name="athlete_geom_12" />
            <site name="contactL" type="box" size="0.13 0.055 0.041" pos="0.055 0 -0.025" />
            <site name="ankleL" />
            <site name="toeL" pos="0.17 0 -0.025" />
          </body>
        </body>
      </body>
      <body name="thigh_R" pos="0 -0.105 -0.055" childclass="leg">
        <joint name="hip_R" axis="0 -1 0" range="-0.5 2.3" />
<joint name="hip_adduction_R" axis="1 0 0" range="-0.2 0.25" damping="2" />
        <geom fromto="0 0 0 0 0 -0.42" mass="7" name="athlete_geom_13" />
        <site name="hipR" />
        <body name="shin_R" pos="0 0 -0.42">
          <joint name="knee_R" axis="0 1 0" range="0 2.7" />
          <geom fromto="0 0 0 0 0 -0.42" size="0.06" mass="3.5" name="athlete_geom_14" />
          <site name="kneeR" />
          <body name="foot_R" pos="0 0 -0.42">
            <joint name="ankle_R" axis="0 1 0" range="-0.6 1.4" />
            <geom type="box" size="0.13 0.055 0.04" pos="0.055 0 -0.025" mass="1" name="athlete_geom_15" />
            <site name="contactR" type="box" size="0.13 0.055 0.041" pos="0.055 0 -0.025" />
            <site name="ankleR" />
            <site name="toeR" pos="0.17 0 -0.025" />
          </body>
        </body>
      </body>
    </body>
    <body name="pool" mocap="true" pos="0 0 -7.5">
      <geom name="pool_floor" type="box" pos="5.45 0 -5.08" size="5.9 3.575 .08" density="0" friction=".8 .02 .002" />
      <geom name="pool_left" type="box" pos="-.53 0 -2.5" size=".09 3.65 2.5" density="0" friction=".8 .02 .002" />
      <geom name="pool_right" type="box" pos="11.43 0 -2.5" size=".09 3.65 2.5" density="0" friction=".8 .02 .002" />
      <geom name="pool_near" type="box" pos="5.45 -3.64 -2.5" size="6.05 .08 2.5" density="0" friction=".8 .02 .002" />
      <geom name="pool_far" type="box" pos="5.45 3.64 -2.5" size="6.05 .08 2.5" density="0" friction=".8 .02 .002" />
    </body>
    <!-- Fixed load-bearing stand colliders match the exposed slab, housing,
         columns and upper rails. Column bottoms extend below the deck so their
         exposed surface is correct at every supported height (3–10 m).
         Decorative ladder rungs and diagonal braces are not collision meshes. -->
    <body name="stand">
      <geom name="stand_slab" type="box" pos="-3.1 0 -.17" size=".85 .9 .10" density="0" />
      <geom name="spring_housing" type="box" pos="-2.14 0 -.74" size=".44 .5 .06" density="0" />
      <geom type="box" pos="-3.66 -0.64 -5.675" size=".11 .11 5.325" density="0" />
      <geom type="box" pos="-3.66 0.64 -5.675" size=".11 .11 5.325" density="0" />
      <geom type="box" pos="-2.56 -0.64 -5.675" size=".11 .11 5.325" density="0" />
      <geom type="box" pos="-2.56 0.64 -5.675" size=".11 .11 5.325" density="0" />
      <geom type="capsule" fromto="-3.84 -0.83 .01 -3.84 -0.83 .82" size=".026" density="0" />
      <geom type="capsule" fromto="-2.54 -0.83 .01 -2.54 -0.83 .82" size=".026" density="0" />
      <geom type="capsule" fromto="-3.84 -0.83 .82 -2.54 -0.83 .82" size=".026" density="0" />
      <geom type="capsule" fromto="-3.81 -0.83 .45 -2.57 -0.83 .45" size=".022" density="0" />
      <geom type="capsule" fromto="-3.84 0.83 .01 -3.84 0.83 .82" size=".026" density="0" />
      <geom type="capsule" fromto="-2.54 0.83 .01 -2.54 0.83 .82" size=".026" density="0" />
      <geom type="capsule" fromto="-3.84 0.83 .82 -2.54 0.83 .82" size=".026" density="0" />
      <geom type="capsule" fromto="-3.81 0.83 .45 -2.57 0.83 .45" size=".022" density="0" />
    </body>
  </worldbody>
  <contact>
    <exclude body1="board" body2="stand" />
    <exclude body1="torso" body2="thigh_L" />
    <exclude body1="torso" body2="thigh_R" />
  </contact>
  <actuator>
    <position name="hip_L" joint="hip_L" kp="300" kv="8" ctrlrange="-0.5 2.3" forcerange="-240 240" />
    <position name="knee_L" joint="knee_L" kp="300" kv="8" ctrlrange="0 2.7" forcerange="-260 260" />
