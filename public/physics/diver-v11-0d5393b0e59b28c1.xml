    <position name="shoulder_roll_R" joint="shoulder_roll_R" kp="70" kv="6" ctrlrange="-1.2 1.2" forcerange="-70 70" />
    <position name="elbow_R" joint="elbow_R" kp="80" kv="6" ctrlrange="0 2.4" forcerange="-70 70" />
  <position name="hip_adduction_L" joint="hip_adduction_L" kp="160" kv="12" ctrlrange="-0.15 0.18" forcerange="-140 140" />
<position name="hip_adduction_R" joint="hip_adduction_R" kp="160" kv="12" ctrlrange="-0.15 0.18" forcerange="-140 140" />
</actuator>
