    <position name="hip_R" joint="hip_R" kp="300" kv="8" ctrlrange="-0.5 2.3" forcerange="-240 240" />
    <position name="knee_R" joint="knee_R" kp="300" kv="8" ctrlrange="0 2.7" forcerange="-260 260" />
    <position name="ankle_R" joint="ankle_R" kp="200" kv="6" ctrlrange="-0.6 1.4" forcerange="-180 180" />
    <position name="shoulder_pitch_L" joint="shoulder_pitch_L" kp="120" kv="10" ctrlrange="-0.6 3.25" forcerange="-120 120" />
    <position name="shoulder_roll_L" joint="shoulder_roll_L" kp="70" kv="6" ctrlrange="-1.2 1.2" forcerange="-70 70" />
    <position name="elbow_L" joint="elbow_L" kp="80" kv="6" ctrlrange="0 2.4" forcerange="-70 70" />
